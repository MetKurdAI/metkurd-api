{
  "info": {
    "name": "MetKurd REST API V2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Official public API examples. All identifiers/credentials are placeholders. Keep keys local. Generation requests are billable and require explicit idempotency identities. No automatic run loop."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://metkurd.ai/api/v2",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "YOUR_API_KEY",
      "type": "string"
    },
    {
      "key": "idempotency_key",
      "value": "YOUR_UNIQUE_REQUEST_ID",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "JOB_ID",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "FILE_ID",
      "type": "string"
    },
    {
      "key": "voice_id",
      "value": "VOICE_ID",
      "type": "string"
    },
    {
      "key": "reference_id",
      "value": "REFERENCE_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Getting Started",
      "description": "Set api_key locally. Start with services/voices. Generation consumes credits. Choose a fresh idempotency_key for each new logical job; preserve it for retries. Do not run the entire collection unattended.",
      "item": [
        {
          "name": "Discover services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/services",
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Discovery / Voices",
      "item": [
        {
          "name": "Discover allowed voice IDs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/voices",
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Speech / Apollo",
      "item": [
        {
          "name": "Submit speech",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/speech",
            "description": "Follow with Jobs → Read job. Choose a new idempotency key for a new logical request. Supply actual discovered/uploaded IDs and local files. No automatic polling or blind submission retry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"سڵاو لە مێتکوردەوە\",\n  \"voice\": \"{{voice_id}}\",\n  \"model\": \"2.0\",\n  \"language\": \"ckb\",\n  \"storage_mode\": \"temporary\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.variables.get(\"idempotency_key\");",
                  "if (!key || key === \"YOUR_UNIQUE_REQUEST_ID\") {",
                  "  throw new Error(\"Set idempotency_key before sending. Keep it for retries; change it only for a NEW logical job.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 202].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Job response contains id and status\", () => {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.status).to.be.oneOf([\"queued\", \"processing\", \"completed\", \"failed\", \"cancelled\"]);",
                  "  });",
                  "  if (body.id) pm.collectionVariables.set(\"job_id\", body.id);",
                  "  pm.collectionVariables.set(\"file_id\", \"FILE_ID\");",
                  "  if (body.status === \"completed\" && !body.result?.expired && body.result?.files?.length) {",
                  "    pm.collectionVariables.set(\"file_id\", body.result.files[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
